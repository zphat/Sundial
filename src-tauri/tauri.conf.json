{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sundial",
  "version": "0.1.32",
  "identifier": "app.sundial.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["sundial"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDQkFGNDMwQTE1MTc1QkMKUldTOGRWR2hNUFM2M0RXVzdmV2s1TkEwckgwSnl4YlVNVlpUbzR6NGw2c0lvd2dNZWpQQk9Mc0kK",
      "endpoints": ["https://github.com/zphat/Sundial/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sundial",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#0B0C0B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Days, tasks, notes",
    "longDescription": "A calendar and to-do app that is fast enough to actually use.",
    "publisher": "zphat",
    "copyright": "Copyright (c) 2026 zphat",
    "homepage": "https://github.com/zphat/Sundial",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
