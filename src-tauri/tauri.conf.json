{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sundial",
  "version": "0.1.2",
  "identifier": "app.sundial.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2QjI3NDQyQzkxRTg5MkMKUldRc2lSN0pRblN5bGg0UTk1TmxoMTZSR29Na053UGZMcWs3SFdSV3VoT0Vlc1YyeXRCQ2xENGsK",
      "endpoints": ["https://github.com/zphat/Sundial/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sundial",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#0B0C0B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Days, tasks, notes",
    "longDescription": "A calendar and to-do app that is fast enough to actually use.",
    "publisher": "Sundial",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
